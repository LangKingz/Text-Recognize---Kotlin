<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
		xmlns:android="http://schemas.android.com/apk/res/android"
		xmlns:tools="http://schemas.android.com/tools"
		xmlns:app="http://schemas.android.com/apk/res-auto"
		android:id="@+id/main"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		tools:context=".CameraActivity">

	<androidx.camera.view.PreviewView android:layout_width="match_parent" android:layout_height="match_parent"
		android:id="@+id/viewFinder"
	/>

	<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
	          android:id="@+id/tvResult"
	          android:background="#bfffffff"
	          android:padding="16dp"
	          android:lines="3"
	          android:maxLines="3"
	          android:textSize="20sp"
	          android:text="Result"
	          android:textColor="@color/black" app:layout_constraintBottom_toBottomOf="parent"
	          app:layout_constraintStart_toStartOf="parent"/>

	<TextView
			android:id="@+id/tvInferenceTime"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:lines="1"
			android:padding="16dp"
			android:textSize="20sp"
			android:gravity="end"
			android:textColor="@color/white"
			app:layout_constraintTop_toTopOf="parent"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			tools:text="Inference Time" />

</androidx.constraintlayout.widget.ConstraintLayout>